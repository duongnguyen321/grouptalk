# Production environment for the bare-process (PM2) deploy — see scripts/deploy.sh.
#
# Optional: If hosting Postgres and Redis via the project's docker-compose.yml on the VPS,
# you can override the host ports (defaults are 25432 and 26379 to avoid conflicts):
# POSTGRES_PORT="25432"
# REDIS_PORT="26379"

# Database connection URL.
# If using the local docker-compose instance: "postgresql://grouptalk:YOUR_PASSWORD@127.0.0.1:${POSTGRES_PORT:-25432}/grouptalk"
DATABASE_URL="postgresql://grouptalk:CHANGE_ME@127.0.0.1:25432/grouptalk"

# Redis connection URL.
# If using the local docker-compose instance: "redis://127.0.0.1:${REDIS_PORT:-26379}"
REDIS_URL="redis://127.0.0.1:26379"

# Auth.js session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Public origin the app is served from (reverse proxy / TLS terminator).
AUTH_URL="https://grouptalk.example.com"
AUTH_TRUST_HOST="true"

# Optional. Leave empty to hide the Google sign-in button on the Splash screen.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
