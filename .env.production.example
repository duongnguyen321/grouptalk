# Production environment for the bare-process (PM2) deploy — see scripts/deploy.sh.
#
# Postgres and Redis are managed independently of the app process. Point these at the
# managed instances, NOT at the docker-compose dev ports (5433/6380) used in local dev.

# Managed Postgres. Include a pooler/SSL param per your provider if required.
DATABASE_URL="postgresql://grouptalk:CHANGE_ME@db.internal:5432/grouptalk"

# Managed Redis.
REDIS_URL="redis://redis.internal:6379"

# Auth.js session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Public origin the app is served from (reverse proxy / TLS terminator).
AUTH_URL="https://grouptalk.example.com"
AUTH_TRUST_HOST="true"

# Optional. Leave empty to hide the Google sign-in button on the Splash screen.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
