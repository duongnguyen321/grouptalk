generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthType {
  DEVICE
  GOOGLE
}

enum Category {
  COUPLE
  GIRLS
  BOYS
  FRIENDS
}

enum QuestionType {
  YESNO
  CHALLENGE
  OPEN_ENDED
}

model User {
  id            String    @id @default(cuid())
  authType      AuthType  @default(DEVICE)
  deviceId      String?   @unique
  googleId      String?   @unique
  displayName   String?
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  ownedSessions     GameSession[]  @relation("SessionOwner")
  contributedQuestions Question[]  @relation("QuestionContributor")
  votes             QuestionVote[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model GameSession {
  id                   String     @id @default(cuid())
  sessionCode          String     @unique
  ownerUserId          String
  copiedFromSessionId  String?
  categories           Category[]
  crushQuestionEnabled Boolean    @default(false)
  createdAt            DateTime   @default(now())
  lastActiveAt         DateTime   @default(now())

  owner      User           @relation("SessionOwner", fields: [ownerUserId], references: [id])
  copiedFrom GameSession?   @relation("SessionCopies", fields: [copiedFromSessionId], references: [id])
  copies     GameSession[]  @relation("SessionCopies")
  players    SessionPlayer[]
  answers    SessionAnswer[]
}

model SessionPlayer {
  id          String @id @default(cuid())
  sessionId   String
  displayName String

  session GameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers SessionAnswer[]
}

model Topic {
  id   String @id @default(cuid())
  name String @unique

  questions Question[]
}

model Question {
  id                  String       @id @default(cuid())
  title               String
  type                QuestionType
  topicId             String
  categories          Category[]
  contributedByUserId String?
  isDeleted           Boolean      @default(false)
  createdAt           DateTime     @default(now())

  topic         Topic           @relation(fields: [topicId], references: [id])
  contributedBy User?           @relation("QuestionContributor", fields: [contributedByUserId], references: [id])
  answers       SessionAnswer[]
  votes         QuestionVote[]
}

model SessionAnswer {
  id              String   @id @default(cuid())
  sessionId       String
  sessionPlayerId String
  questionId      String
  answeredAt      DateTime @default(now())

  session       GameSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionPlayer SessionPlayer @relation(fields: [sessionPlayerId], references: [id], onDelete: Cascade)
  question      Question      @relation(fields: [questionId], references: [id])

  @@unique([sessionId, sessionPlayerId, questionId])
}

model QuestionVote {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}
